{
	"name": "qnxg-agent",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"build": "pnpm --filter @qnxg/webui build",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"typecheck": "pnpm -r typecheck",
		"check": "pnpm lint && pnpm typecheck",
		"fix": "pnpm lint:fix && pnpm typecheck",
		"agent": "pnpm --filter @qnxg/backend agent",
		"loop": "pnpm --filter @qnxg/backend loop",
		"web": "pnpm --filter @qnxg/backend web",
		"web:dev": "concurrently -k \"pnpm --filter @qnxg/backend web:api\" \"pnpm --filter @qnxg/webui dev\""
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"concurrently": "^10.0.5"
	}
}
